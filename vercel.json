{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calendar/:propertyId/:token.ics",
      "destination": "https://eitpwcnsoshweoqzusdk.supabase.co/functions/v1/export-calendar-ics?propertyId=:propertyId&token=:token"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap-listings.xml",
      "destination": "/api/property-seo?sitemap=1"
    },
    {
      "source": "/api/property-preview",
      "destination": "/api/property-seo?format=json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/.well-known/apple-app-site-association"
    },
    {
      "source": "/property/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|WhatsApp|Telegram|Slackbot|Discordbot|LinkedInBot|Twitterbot|Pinterest|Embedly|Applebot|Bingbot|GPTBot|ClaudeBot|PerplexityBot|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/property-seo?slug=:slug"
    },
    {
      "source": "/:place/stays",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|WhatsApp|Telegram|Slackbot|Discordbot|LinkedInBot|Twitterbot|Pinterest|Embedly|Applebot|Bingbot|GPTBot|ClaudeBot|PerplexityBot|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/property-seo?place=:place"
    },
    {
      "source": "/:place/stays/:cat",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|WhatsApp|Telegram|Slackbot|Discordbot|LinkedInBot|Twitterbot|Pinterest|Embedly|Applebot|Bingbot|GPTBot|ClaudeBot|PerplexityBot|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/property-seo?place=:place&cat=:cat"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "images": {
    "sizes": [
      200,
      320,
      480,
      640,
      900,
      1400,
      1800
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "eitpwcnsoshweoqzusdk.supabase.co",
        "pathname": "/storage/v1/object/public/**"
      }
    ]
  }
}
